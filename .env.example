# Copy to .env and fill in. Every variable is optional except the API key for the assistant.
# Settings are read by src/core/config.py; names are case-insensitive.

# --- LLM (GenAI assistant) ---
# Gemini API key from https://aistudio.google.com/apikey. GOOGLE_API_KEY is accepted as an alias.
GEMINI_API_KEY=
# Model to use. gemini-3.5-flash-lite is the cheap default; gemini-3.8-flash for better reasoning.
ASSISTANT_MODEL=gemini-3.5-flash-lite
# Where the running API is (the assistant calls it over HTTP).
ASSISTANT_API_URL=http://localhost:8000
# Session persistence (SQLite) and the LLM call log (JSON lines).
ASSISTANT_SESSION_DB=data/assistant_sessions.db
ASSISTANT_LOG_PATH=logs/assistant.jsonl
# Guardrails: caps per user turn.
ASSISTANT_MAX_LLM_CALLS=8
ASSISTANT_MAX_TOOL_CALLS=6

# --- API service ---
LOG_LEVEL=INFO
DB_PATH=data/warehouse.duckdb
DQ_REPORT_PATH=reports/dq_report.json
MODEL_PATH=models/delay_model.joblib
